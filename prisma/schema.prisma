datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum AuditAction {
  CREATE
  UPDATE
  ARCHIVE
  RESTORE
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  passwordHash    String
  fullName        String
  defaultCurrency String        @default("USD")
  transactions    Transaction[]
  categories      Category[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([email])
}

model Category {
  id           String          @id @default(cuid())
  name         String
  type         TransactionType // INCOME or EXPENSE
  color        String          @default("#6366f1") // Hex color for charts
  icon         String          @default("tag")     // Lucide icon name
  userId       String?                             // Null = System default; Not-null = User custom
  user         User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  createdAt    DateTime        @default(now())

  @@index([userId])
  @@index([type])
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  type        TransactionType
  amount      Decimal         @db.Decimal(12, 2) // Guarantees zero floating-point roundoff
  date        DateTime        // ISO date of expenditure/income
  description String
  isArchived  Boolean         @default(false)
  archivedAt  DateTime?
  auditLogs   AuditLog[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Composite indexes for rapid multi-tenant analytics
  @@index([userId, isArchived, date])
  @@index([userId, isArchived, type])
  @@index([userId, isArchived, categoryId])
  @@index([userId, createdAt])
}

model AuditLog {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  action        AuditAction
  details       String      // Serialized JSON with modifiedFields: { from, to }
  performedBy   String      // User ID or "system"
  timestamp     DateTime    @default(now())

  @@index([transactionId])
  @@index([performedBy])
  @@index([timestamp])
}
