# ==============================================================================
# Arcfield Expense Tracker — Environment Variables Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to `.env`:
#      cp .env.example .env
# 2. Replace all placeholder values with your project credentials.
# 3. NEVER commit the actual `.env` file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection Strings (Prisma ORM & Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Supabase Transaction Pooler (Port 6543) — used by Prisma Client for app queries
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.your-project-ref:your-database-password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Session Pooler (Port 5432) — used by Prisma CLI for migrations & db push
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres.your-project-ref:your-database-password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. Supabase Client Credentials (Public API & Realtime CDC)
# ------------------------------------------------------------------------------
# Supabase Project API URL (Found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Anonymous Publishable Key (Safe for browser use)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ------------------------------------------------------------------------------
# 3. Authentication & Session Security (Jose JWT)
# ------------------------------------------------------------------------------
# Secret key used for signing session JWT tokens (minimum 32 characters).
# Generate a cryptographically secure key via:
#   openssl rand -base64 32
JWT_SECRET="replace-with-a-secure-random-32-char-minimum-jwt-secret"

# ------------------------------------------------------------------------------
# 4. Application Configuration
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
